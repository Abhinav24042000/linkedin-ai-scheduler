# ============================================
# LinkedIn Post Scheduler - Environment Config
# ============================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# --- Encryption ---
# 32-byte (64 hex chars) key for encrypting stored credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-random-64-hex-char-string

# --- LinkedIn OAuth ---
# Create an app at https://www.linkedin.com/developers/
# Required products: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# Set redirect URL to: http://localhost:3001/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

# --- Client URL ---
# Frontend URL for CORS (default: Vite dev server)
CLIENT_URL=http://localhost:5173

# --- Database ---
# Path to SQLite database file (relative to server directory)
DB_PATH=./data/linkedin-scheduler.db
